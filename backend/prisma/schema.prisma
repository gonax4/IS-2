// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String
  lastName  String
  password  String
  role      Role     @default(CITIZEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?

  reports Report[]

  passwordResetToken   String?
  passwordResetExpires DateTime?

  followedReports ReportFollow[]
  notifications   Notification[]

  technicianProfile TechnicianProfile?

  technicianAssignments ReportAssignment[] @relation("TechnicianAssignments")
  operatorAssignments   ReportAssignment[] @relation("OperatorAssignments")

  technicalAttentions TechnicalAttention[]

  fieldWorks FieldWork[]

  municipalityId String?
  municipality   Municipality? @relation(fields: [municipalityId], references: [id])

  technicalClosures TechnicalClosure[]
}

enum Role {
  CITIZEN
  OPERATOR
  TECHNICIAN
}

model Report {
  id String @id @default(uuid())

  title String

  category ReportCategory

  problemType String

  categoryId  String?
  categoryRef Category? @relation(fields: [categoryId], references: [id])

  problemTypeId  String?
  problemTypeRef ProblemType? @relation(fields: [problemTypeId], references: [id])

  description String

  latitude  Float?
  longitude Float?

  address String?

  isAnonymous Boolean @default(false)

  status Status @default(REGISTERED)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  evidences ReportEvidence[]

  assignments ReportAssignment[]

  technicalAttentions TechnicalAttention[]

  priority        Priority?
  impact          String?
  probability     String?
  operationalType String?
  targetDate      DateTime?
  justification   String?

  followers     ReportFollow[]
  notifications Notification[]
  resolvedAt    DateTime?

  fieldWork FieldWork?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  municipalityId String?
  municipality   Municipality? @relation(fields: [municipalityId], references: [id])

  technicalClosure TechnicalClosure?

  @@index([userId])
}

model ReportEvidence {
  id String @id @default(uuid())

  imageUrl String

  reportId String

  report Report @relation(fields: [reportId], references: [id])

  createdAt DateTime @default(now())

  @@index([reportId])
}

model ReportAssignment {
  id String @id @default(uuid())

  reportId     String
  technicianId String
  assignedById String

  assignedAt DateTime @default(now())

  notes String?

  active Boolean @default(true)

  report Report @relation(fields: [reportId], references: [id])

  technician User @relation("TechnicianAssignments", fields: [technicianId], references: [id])

  assignedBy User @relation("OperatorAssignments", fields: [assignedById], references: [id])

  @@index([reportId])
  @@index([technicianId])
  @@index([assignedById])
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  problemTypes ProblemType[]
  reports      Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProblemType {
  id          String  @id @default(uuid())
  name        String
  description String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClosureReason {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SlaConfiguration {
  id String @id @default(uuid())

  priority Priority @unique

  responseHours Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportFollow {
  id String @id @default(uuid())

  userId   String
  reportId String

  user   User   @relation(fields: [userId], references: [id])
  report Report @relation(fields: [reportId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, reportId])
  @@index([userId])
  @@index([reportId])
}

model Notification {
  id String @id @default(uuid())

  userId   String
  reportId String?

  title   String
  message String
  read    Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id])
  report Report? @relation(fields: [reportId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([reportId])
}

enum Status {
  REGISTERED
  VALIDATING
  APPROVED
  REJECTED
  PRIORITIZED
  ASSIGNED
  IN_TRANSIT
  IN_PROGRESS
  RESOLVED
}

enum ReportCategory {
  SECURITY
  ENVIRONMENT
  INFRASTRUCTURE
  MOBILITY
}

enum TechnicianApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model TechnicianApplication {
  id String @id @default(uuid())

  firstName String
  lastName  String
  email     String  @unique
  phone     String?
  dni       String?

  municipalityId String?
  municipality   Municipality? @relation(fields: [municipalityId], references: [id])
  skills         String[]
  experience     String?

  status TechnicianApplicationStatus @default(PENDING)

  reviewedAt   DateTime?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TechnicianProfile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  municipalityId String?
  municipality   Municipality? @relation(fields: [municipalityId], references: [id])

  skills    String[]
  available Boolean  @default(true)
  crewName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Priority {
  BAJO
  MEDIO
  ALTO
}

model Municipality {
  id String @id @default(uuid())

  name String @unique

  district String?

  province String?

  department String?

  operators User[]

  reports Report[]

  technicianApplications TechnicianApplication[]

  technicianProfiles TechnicianProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TechnicalAttention {
  id String @id @default(uuid())

  reportId String
  report   Report @relation(fields: [reportId], references: [id])

  technicianId String
  technician   User   @relation(fields: [technicianId], references: [id])

  checklist   Json
  fieldValues Json

  actionTaken     String
  technicalResult String
  observations    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@index([technicianId])
}

enum EvidencePhase {
  BEFORE
  AFTER
}

model FieldWork {
  id String @id @default(uuid())

  reportId String @unique
  report   Report @relation(fields: [reportId], references: [id])

  technicianId String
  technician   User   @relation(fields: [technicianId], references: [id])

  arrivedAt DateTime?
  closedAt  DateTime?

  arrivalLat     Float?
  arrivalLng     Float?
  distanceMeters Float?

  notes String?

  evidences FieldWorkEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianId])
}

model FieldWorkEvidence {
  id String @id @default(uuid())

  fieldWorkId String
  fieldWork   FieldWork @relation(fields: [fieldWorkId], references: [id])

  imageUrl String
  phase    EvidencePhase

  createdAt DateTime @default(now())

  @@index([fieldWorkId])
}

enum TechnicalClosureResult {
  RESOLVED_ON_SITE
  TEMPORARY_MITIGATION
  NO_INCIDENT_FOUND
  DUPLICATE
  OUT_OF_SCOPE
  FOLLOW_UP_REQUIRED
}

model TechnicalClosure {
  id String @id @default(uuid())

  reportId String @unique
  report   Report @relation(fields: [reportId], references: [id])

  technicianId String
  technician   User   @relation(fields: [technicianId], references: [id])

  result TechnicalClosureResult

  observations String

  closureEvidenceUrl String?

  followUpRequired Boolean @default(false)
  followUpNotes    String?

  closedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianId])
}
